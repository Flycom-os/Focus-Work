generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:nikita12345@localhost:5432/focusWork?schema=public"
}

// ---------- Основные типы ----------
enum Role {
  ADMIN
  READ
  EDITE
  WRITE
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  READY
  COMPLETED
  CANCELED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum BookingType {
  TABLE
  EVENT
  MEETING
  PRIVATE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  BONUS
  FREE
}

enum TransactionType {
  INCOME
  EXPENSE
  WRITE_OFF
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  icon      String?
  password  String
  fullName  String
  role      Role     @default(READ)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // связи
  employee              Employee?
  customer              Customer?
  boards                Board[]
  trackerAssignedIssues TrackerIssue[]     @relation("TrackerAssignee")
  trackerCreatedIssues  TrackerIssue[]     @relation("TrackerCreator")
  trackerTimeEntries    TrackerTimeEntry[]

  // New YT-Tracker Relations
  ytOwnedProjects      YtProject[]       @relation("YtProjectOwner")
  ytProjectMemberships YtProjectMember[] @relation("YtProjectMember")
  ytAuthoredIssues     YtIssue[]         @relation("YtIssueAuthor")
  ytAssignedIssues     YtIssue[]         @relation("YtIssueAssignee")
  ytComments           YtComment[]       @relation("YtCommentAuthor")
  ytWorklogs           YtWorklog[]       @relation("YtWorklogAuthor")
  ytHistoryEntries     YtIssueHistory[]  @relation("YtIssueHistoryAuthor")
  ytSavedSearches      YtSavedSearch[]   @relation("YtSavedSearchOwner")
  ytDashboards         YtDashboard[]     @relation("YtDashboardOwner")
  BoardMember          BoardMember[]
  ElementVersion       ElementVersion[]
  CrmDeal              CrmDeal[]
}

model Employee {
  id       String   @id @default(uuid())
  userId   String   @unique
  position String
  salary   Float?
  hiredAt  DateTime @default(now())
  kpis     Kpi[]

  user      User      @relation(fields: [userId], references: [id])
  branch    Branch?   @relation(fields: [branchId], references: [id])
  branchId  String?
  bookings  Booking[] // бронирования, которые обслуживает сотрудник
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Kpi {
  id         String   @id @default(uuid())
  employeeId String
  metric     String
  value      Float
  date       DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id           String   @id @default(uuid())
  name         String
  icon         String?
  address      String
  city         String
  region       String?
  postalCode   String?
  country      String   @default("Россия")
  phone        String?
  email        String?
  website      String?
  latitude     Float?
  longitude    Float?
  timezone     String   @default("Europe/Moscow")
  openTime     String?
  closeTime    String?
  isActive     Boolean  @default(true)
  managerName  String?
  managerPhone String?
  area         Float? // площадь в м²
  capacity     Int? // вместимость
  description  String?
  createdAt    DateTime @default(now())

  employees Employee[]
  stocks    Stock[]
  orders    Order[]
  bookings  Booking[]
  updatedAt DateTime   @updatedAt
}

model Product {
  id           String   @id @default(uuid())
  name         String
  nameEn       String?
  icon         String?
  category     Category @relation(fields: [categoryId], references: [id])
  categoryId   String
  price        Float
  cost         Float?
  oldPrice     Float?
  sku          String?  @unique // артикул
  barcode      String?  @unique // штрихкод
  unit         String   @default("шт") // единица измерения
  weight       Float? // вес в граммах
  volume       Float? // объем в мл
  calories     Int? // калории
  proteins     Float? // белки
  fats         Float? // жиры
  carbs        Float? // углеводы
  description  String?
  composition  String? // состав
  allergens    String? // аллергены
  shelfLife    Int? // срок годности в днях
  storageTemp  String? // температура хранения
  imageUrl     String?
  images       String[] // массив дополнительных изображений
  isIngredient Boolean  @default(false) // true если товар — ингредиент, иначе готовый продукт
  isActive     Boolean  @default(true)
  isPopular    Boolean  @default(false)
  isNew        Boolean  @default(false)
  sortOrder    Int      @default(0)
  tags         String[] // теги

  stocks     Stock[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Stock {
  id              String    @id @default(uuid())
  branchId        String
  productId       String
  quantity        Int       @default(0)
  reserved        Int       @default(0) // зарезервировано
  minQuantity     Int       @default(0) // минимальный остаток
  maxQuantity     Int? // максимальный остаток
  reorderPoint    Int? // точка заказа
  location        String? // место хранения на складе
  batchNumber     String? // номер партии
  expiryDate      DateTime? // срок годности
  purchasePrice   Float? // закупочная цена
  supplier        String? // поставщик
  lastRestockedAt DateTime? // последнее пополнение
  notes           String? // заметки

  branch       Branch             @relation(fields: [branchId], references: [id])
  product      Product            @relation(fields: [productId], references: [id])
  transactions StockTransaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([branchId, productId])
}

model StockTransaction {
  id          String          @id @default(uuid())
  stockId     String
  type        TransactionType
  quantity    Int
  date        DateTime        @default(now())
  price       Float? // цена за единицу
  totalPrice  Float? // общая стоимость
  reason      String? // причина операции
  document    String? // номер документа (накладная, счет и т.д.)
  supplier    String? // поставщик
  batchNumber String? // номер партии
  expiryDate  DateTime? // срок годности для этой партии
  employeeId  String? // кто провел операцию
  notes       String? // примечания
  orderId     String?

  order Order? @relation(fields: [orderId], references: [id])

  stock     Stock    @relation(fields: [stockId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// link from Order to its stock transactions
model Order {
  id         String          @id @default(uuid())
  branchId   String
  customerId String?
  type       TransactionType @default(EXPENSE)
  status     OrderStatus     @default(NEW)
  total      Float
  createdAt  DateTime        @default(now())

  branch            Branch             @relation(fields: [branchId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  stockTransactions StockTransaction[]
  updatedAt         DateTime           @updatedAt
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String             @id @default(uuid())
  userId          String             @unique
  bonus           Int                @default(0) // текущий баланс бонусов
  totalSpent      Float              @default(0) // общая сумма покупок
  totalOrders     Int                @default(0) // общее количество заказов
  averageCheck    Float? // средний чек
  lastOrderDate   DateTime? // дата последнего заказа
  favoriteProduct String? // любимый товар (productId)
  favoriteBranch  String? // любимый филиал (branchId)
  discountPercent Float?             @default(0) // процент скидки
  vipStatus       Boolean            @default(false) // VIP статус
  notes           String? // заметки о клиенте
  tags            String[] // теги для сегментации
  source          String? // источник (сайт, приложение, офлайн)
  referralCode    String?            @unique // реферальный код
  referredBy      String? // кто привел (customerId)
  birthday        DateTime? // день рождения
  preferences     String? // предпочтения (JSON)
  orders          Order[]
  bookings        Booking[]
  bonusHistory    BonusTransaction[] // история бонусных операций

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BonusTransaction {
  id          String    @id @default(uuid())
  customerId  String
  type        String // EARNED, SPENT, EXPIRED, ADJUSTED
  amount      Int // количество бонусов
  orderId     String? // связанный заказ
  description String? // описание операции
  expiresAt   DateTime? // срок действия бонусов
  customer    Customer  @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id                 String         @id @default(uuid())
  branchId           String
  customerId         String
  employeeId         String? // кто обслуживает
  title              String? // название/описание
  description        String? // описание события
  date               DateTime // дата бронирования
  timeFrom           DateTime // время начала
  timeTo             DateTime // время окончания
  duration           Int? // продолжительность в минутах
  type               BookingType    @default(TABLE) // тип бронирования
  status             BookingStatus  @default(PENDING)
  guestsCount        Int            @default(1) // количество гостей
  tableNumber        String? // номер стола
  contactName        String? // контактное имя (если не клиент)
  contactPhone       String? // контактный телефон
  contactEmail       String? // контактный email
  specialRequests    String? // особые пожелания
  notes              String? // внутренние заметки
  price              Float? // стоимость бронирования
  deposit            Float? // предоплата
  paymentMethod      PaymentMethod? // способ оплаты
  isPaid             Boolean        @default(false) // оплачено ли
  isConfirmed        Boolean        @default(false) // подтверждено клиентом
  confirmationCode   String?        @unique // код подтверждения
  reminderSent       Boolean        @default(false) // отправлено ли напоминание
  reminderDate       DateTime? // когда отправить напоминание
  cancelledAt        DateTime? // когда отменено
  cancelledBy        String? // кто отменил (userId)
  cancellationReason String? // причина отмены
  completedAt        DateTime? // когда завершено
  recurrenceRule     String? // правило повтора (RRULE format)
  parentBookingId    String? // ID родительского бронирования для повторяющихся
  source             String? // источник бронирования (сайт, телефон, приложение)
  tags               String[] // теги для фильтрации

  branch    Branch    @relation(fields: [branchId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  type      String
  period    String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id            String   @id @default(uuid())
  icon          String?
  name          String
  description   String?
  legalName     String? // юридическое название
  inn           String? // ИНН
  kpp           String? // КПП
  ogrn          String? // ОГРН
  address       String? // юридический адрес
  actualAddress String? // фактический адрес
  phone         String? // телефон
  email         String? // email
  website       String? // сайт
  director      String? // директор
  accountant    String? // бухгалтер
  bankName      String? // банк
  bankAccount   String? // расчетный счет
  bankBik       String? // БИК
  taxSystem     String? // система налогообложения
  logo          String? // логотип
  settings      String? // настройки (JSON)
  timezone      String   @default("Europe/Moscow")
  currency      String   @default("RUB")
  language      String   @default("ru")
  createdAt     DateTime @default(now())

  PaymentSettings PaymentSettings[]
  Integration     Integration[]
  CrmContact      CrmContact[]
  CrmDeal         CrmDeal[]
  updatedAt       DateTime          @updatedAt
}

model PaymentSettings {
  id         String   @id @default(uuid())
  icon       String?
  provider   String // SBERBANK, YOOKASSA, TINKOFF, etc.
  name       String? // название настройки
  apiKey     String // API ключ
  secretKey  String? // секретный ключ
  merchantId String? // ID мерчанта
  terminalId String? // ID терминала
  isActive   Boolean  @default(true)
  isTest     Boolean  @default(false) // тестовый режим
  commission Float? // комиссия в процентах
  minAmount  Float? // минимальная сумма
  maxAmount  Float? // максимальная сумма
  webhookUrl String? // URL для webhook
  settings   String? // дополнительные настройки (JSON)
  companyId  String   @unique
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Integration {
  id           String    @id @default(uuid())
  icon         String?
  name         String // название интеграции
  type         String // тип (CRM, ACCOUNTING, DELIVERY, SMS, EMAIL, etc.)
  provider     String? // провайдер (AMOCRM, 1C, etc.)
  apiKey       String? // API ключ
  apiSecret    String? // секретный ключ
  apiUrl       String? // URL API
  webhookUrl   String? // URL для webhook
  isActive     Boolean   @default(true)
  isTest       Boolean   @default(false)
  settings     String? // настройки (JSON)
  lastSyncAt   DateTime? // последняя синхронизация
  syncStatus   String? // статус синхронизации
  errorMessage String? // сообщение об ошибке
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Miro (whiteboard) ----------
enum BoardRole {
  OWNER
  EDITOR
  VIEWER
  COMMENTER
}

enum ElementType {
  SHAPE
  TEXT
  STICKY
  IMAGE
  FRAME
  EMBED
  LINE
  ARROW
  NOTE
  CARD
  DRAW
}

model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String?
  project   YtProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  members   BoardMember[]
  elements  Element[]
  snapshots BoardSnapshot[]

  @@index([projectId])
  @@index([ownerId])
}

model BoardMember {
  id      String    @id @default(uuid())
  role    BoardRole @default(VIEWER)
  boardId String
  userId  String

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, userId])
  @@index([userId])
}

model Element {
  id        String      @id @default(uuid())
  type      ElementType
  x         Float
  y         Float
  width     Float
  height    Float
  rotation  Float       @default(0)
  zIndex    Int
  style     Json? // For colors, fonts, opacity, etc.
  content   Json? // For serialized data, text content, etc.
  boardId   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // Link to other modules
  linkedIssueId String?
  linkedIssue   YtIssue? @relation(fields: [linkedIssueId], references: [id], onDelete: SetNull)

  versions ElementVersion[]

  @@index([boardId])
  @@index([linkedIssueId])
}

model ElementVersion {
  id        String   @id @default(uuid())
  elementId String
  data      Json // Snapshot of the element's state (style, content, position)
  authorId  String
  createdAt DateTime @default(now())

  element Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([elementId])
  @@index([authorId])
}

model BoardSnapshot {
  id        String   @id @default(uuid())
  boardId   String
  data      Bytes // Efficiently stored binary snapshot of the board state
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model CursorPosition {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  x         Float
  y         Float
  updatedAt DateTime @updatedAt

  @@unique([boardId, userId])
}

// ---------- Tracker (issues + timesheets) ----------
model TrackerIssue {
  id        String @id @default(uuid())
  key       String @unique
  summary   String
  boardId   String
  type      String @default("No Type")
  priority  String @default("Normal")
  state     String @default("Open")
  subsystem String @default("No Subsystem")
  project   String @default("WHS")

  assigneeId String?
  assignee   User?   @relation("TrackerAssignee", fields: [assigneeId], references: [id])

  creatorId String
  creator   User   @relation("TrackerCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([assigneeId])
  @@index([creatorId])
}

model TrackerTimeEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  weekTitle String
  day       String
  hours     Float   @default(0)
  issueKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekTitle, day])
  @@index([userId])
}

// ---------- YouTrack-like Tracker Module ----------

// Projects are the top-level containers for issues.
model YtProject {
  id          String   @id @default(uuid())
  name        String
  key         String   @unique // Short identifier for the project, e.g., "PROJ"
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId         String
  owner           User              @relation("YtProjectOwner", fields: [ownerId], references: [id])
  members         YtProjectMember[]
  issues          YtIssue[]
  sprints         YtSprint[]
  boards          YtAgileBoard[]
  customFields    YtCustomField[]
  issueTypes      YtIssueType[]
  issueStates     YtIssueState[]
  issuePriorities YtIssuePriority[]
  savedSearches   YtSavedSearch[]
  dashboards      YtDashboard[]
  Board           Board[]
}

// Defines user membership and roles within a project.
model YtProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      Role   @default(READ) // Re-using existing Role enum

  project YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User      @relation("YtProjectMember", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
}

// Issues are the core entity for tracking tasks, bugs, etc.
model YtIssue {
  id          String    @id @default(uuid())
  numericId   Int       @default(autoincrement())
  key         String    @unique // Combination of project key and numericId, e.g., "PROJ-123"
  summary     String
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  archivedAt  DateTime?
  estimation  Int? // Story points or time estimate in minutes

  projectId String
  project   YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("YtIssueAuthor", fields: [authorId], references: [id])

  assigneeId String?
  assignee   User?   @relation("YtIssueAssignee", fields: [assigneeId], references: [id])

  typeId String?
  type   YtIssueType? @relation(fields: [typeId], references: [id])

  stateId String?
  state   YtIssueState? @relation(fields: [stateId], references: [id])

  priorityId String?
  priority   YtIssuePriority? @relation(fields: [priorityId], references: [id])

  sprintId String?
  sprint   YtSprint? @relation(fields: [sprintId], references: [id])

  parentId String?
  parent   YtIssue?  @relation("YtIssueSubtasks", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks YtIssue[] @relation("YtIssueSubtasks")

  customFieldValues YtCustomFieldValue[]
  comments          YtComment[]
  history           YtIssueHistory[]
  worklogs          YtWorklog[]
  linksAsSource     YtIssueLink[]        @relation("SourceIssue")
  linksAsTarget     YtIssueLink[]        @relation("TargetIssue")
  Element           Element[]

  @@unique([projectId, numericId])
  @@index([assigneeId])
  @@index([authorId])
  @@index([stateId])
  @@index([sprintId])
}

// Types of issues, e.g., Bug, Task, Story.
model YtIssueType {
  id        String    @id @default(uuid())
  name      String
  iconUrl   String?
  projectId String
  project   YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isDefault Boolean   @default(false)
  issues    YtIssue[]

  @@unique([projectId, name])
}

// States for issues, e.g., Open, In Progress, Done. Part of a workflow.
model YtIssueState {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#8A8A8A") // UI color hint
  projectId String
  project   YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isDefault Boolean   @default(false)
  isDone    Boolean   @default(false) // Marks a final state
  issues    YtIssue[]

  @@unique([projectId, name])
}

// Priority levels for issues.
model YtIssuePriority {
  id        String    @id @default(uuid())
  name      String
  iconUrl   String?
  color     String?
  projectId String
  project   YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isDefault Boolean   @default(false)
  order     Int       @default(0) // For sorting
  issues    YtIssue[]

  @@unique([projectId, name])
}

// Linking between issues, e.g., duplicates, relates to, blocks.
enum YtIssueLinkType {
  RELATES_TO
  BLOCKS
  IS_BLOCKED_BY
  DUPLICATES
  IS_DUPLICATED_BY
  SUBTASK_OF
  PARENT_FOR
}

model YtIssueLink {
  id       String          @id @default(uuid())
  linkType YtIssueLinkType

  sourceIssueId String
  sourceIssue   YtIssue @relation("SourceIssue", fields: [sourceIssueId], references: [id], onDelete: Cascade)

  targetIssueId String
  targetIssue   YtIssue @relation("TargetIssue", fields: [targetIssueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sourceIssueId, targetIssueId, linkType])
}

// Custom fields definition for projects.
enum YtCustomFieldType {
  STRING
  INTEGER
  FLOAT
  DATE
  DATETIME
  BOOLEAN
  ENUM_SINGLE
  ENUM_MULTI
  USER_SINGLE
  USER_MULTI
  MARKDOWN
  URL
}

model YtCustomField {
  id        String               @id @default(uuid())
  name      String
  type      YtCustomFieldType
  projectId String
  project   YtProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  settings  Json? // For enum options, etc. e.g., { "options": ["A", "B"] }
  values    YtCustomFieldValue[]

  @@unique([projectId, name])
}

// Values for custom fields on a specific issue.
model YtCustomFieldValue {
  id            String        @id @default(uuid())
  issueId       String
  issue         YtIssue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   YtCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  stringValue   String?
  integerValue  Int?
  floatValue    Float?
  datetimeValue DateTime?
  booleanValue  Boolean?
  jsonValue     Json? // For multi-select enums or users

  @@unique([issueId, customFieldId])
}

// Sprints for organizing work in timeboxes.
model YtSprint {
  id        String    @id @default(uuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  isLocked  Boolean   @default(false)
  projectId String
  project   YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    YtIssue[]

  @@unique([projectId, name])
}

// Agile boards (Kanban or Scrum) for visualizing issues.
model YtAgileBoard {
  id             String          @id @default(uuid())
  name           String
  isScrum        Boolean         @default(false) // false = Kanban, true = Scrum
  projectId      String
  project        YtProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns        YtBoardColumn[]
  activeSprintId String?
  swimlaneField  String? // e.g., 'assignee', 'epic', or a custom field ID
  filterQuery    String? // A query to filter issues on the board

  @@unique([projectId, name])
}

model YtBoardColumn {
  id       String       @id @default(uuid())
  name     String
  wipLimit Int?
  boardId  String
  board    YtAgileBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  states   Json? // Array of YtIssueState IDs that map to this column
  order    Int          @default(0)
}

// Comments on issues.
model YtComment {
  id          String         @id @default(uuid())
  body        String         @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  authorId    String
  author      User           @relation("YtCommentAuthor", fields: [authorId], references: [id])
  issueId     String
  issue       YtIssue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  attachments YtAttachment[]

  @@index([issueId])
}

model YtAttachment {
  id        String     @id @default(uuid())
  filename  String
  url       String
  mimetype  String
  size      Int // in bytes
  createdAt DateTime   @default(now())
  commentId String?
  comment   YtComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// Time tracking entries.
model YtWorklog {
  id          String   @id @default(uuid())
  date        DateTime
  duration    Int // in minutes
  description String?
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation("YtWorklogAuthor", fields: [authorId], references: [id])
  issueId     String
  issue       YtIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// History of changes to an issue.
model YtIssueHistory {
  id        String   @id @default(uuid())
  field     String // e.g., 'assignee', 'state', 'summary'
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation("YtIssueHistoryAuthor", fields: [authorId], references: [id])
  issueId   String
  issue     YtIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// Saved searches/filters by users.
model YtSavedSearch {
  id        String    @id @default(uuid())
  name      String
  query     String
  ownerId   String
  owner     User      @relation("YtSavedSearchOwner", fields: [ownerId], references: [id])
  projectId String
  project   YtProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([ownerId, projectId, name])
}

// User dashboards.
model YtDashboard {
  id        String              @id @default(uuid())
  name      String
  ownerId   String
  owner     User                @relation("YtDashboardOwner", fields: [ownerId], references: [id])
  projectId String? // Link to project if it's a project dashboard
  project   YtProject?          @relation(fields: [projectId], references: [id])
  layout    Json? // Layout of widgets
  widgets   YtDashboardWidget[]

  @@unique([ownerId, name])
}

enum YtDashboardWidgetType {
  SAVED_SEARCH
  BURNDOWN
  VELOCITY
  CUSTOM
}

model YtDashboardWidget {
  id          String                @id @default(uuid())
  dashboardId String
  dashboard   YtDashboard           @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  type        YtDashboardWidgetType
  settings    Json // Widget-specific settings, e.g., { savedSearchId: "..." }
}

// ---------- CRM ----------

enum CrmDealStatus {
  LEAD
  CONTACT_MADE
  PROPOSAL_SENT
  IN_NEGOTIATION
  WON
  LOST
}

enum CrmStockMovementType {
  INBOUND // Приход
  OUTBOUND // Расход
  TRANSFER // Перемещение
  ADJUSTMENT // Корректировка/инвентаризация
  RETURN // Возврат
}

enum CrmCameraEventType {
  MOTION_DETECTED
  AREA_ENTERED
  AREA_EXITED
  LINE_CROSSED
  FACE_RECOGNIZED
  LICENSE_PLATE_RECOGNIZED
  TAMPERING_DETECTED
}

model CrmContact {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  deals     CrmDeal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmDeal {
  id        String        @id @default(uuid())
  name      String
  status    CrmDealStatus @default(LEAD)
  amount    Float
  companyId String?
  company   Company?      @relation(fields: [companyId], references: [id])
  contactId String?
  contact   CrmContact?   @relation(fields: [contactId], references: [id])
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id])
  orders    CrmOrder[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CrmWarehouse {
  id        String    @id @default(uuid())
  name      String
  address   String?
  Stock     CrmStock[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CrmProduct {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  description   String?
  price         Float
  stocks        CrmStock[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CrmStock {
  id          String @id @default(uuid())
  productId   String
  product     CrmProduct @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   CrmWarehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int
  movements   CrmStockMovement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CrmStockMovement {
  id          String               @id @default(uuid())
  type        CrmStockMovementType
  stockId     String
  stock       CrmStock             @relation(fields: [stockId], references: [id])
  quantity    Int
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CrmOrder {
  id        String   @id @default(uuid())
  dealId    String?
  deal      CrmDeal? @relation(fields: [dealId], references: [id])
  shipments CrmShipment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmShipment {
  id        String   @id @default(uuid())
  orderId   String
  order     CrmOrder @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmCamera {
  id        String             @id @default(uuid())
  name      String
  rtspUrl   String
  events    CrmCameraEvent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model CrmCameraEvent {
  id        String             @id @default(uuid())
  cameraId  String
  camera    CrmCamera          @relation(fields: [cameraId], references: [id])
  type      CrmCameraEventType
  timestamp DateTime
  data      Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}
